<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN. It cannot be changed between the plugin versions. -->
    <id>de.junidas.webobjects.ijplugin</id>

    <!-- Public plugin name should be written in Title Case.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/plugin-overview-page.html#plugin-name -->
    <name>WebObjects / WONDER</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Marketplace. -->
    <vendor email="markus.stoll@junidas.de" url="https://www.junidas.de">Markus Stoll</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Simple HTML elements (text formatting, paragraphs, and lists) can be added inside of <![CDATA[ ]]> tag.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/plugin-overview-page.html#plugin-description -->
    <description><![CDATA[
      WebObjects Plugin for IntelliJ IDEA.<br>
      Provides rich support for WebObjects development:
      <ul>
        <li>WOComponent file structure (.wo, .html, .wod, .woo, .api)</li>
        <li>WOD grammar, parser, syntax highlighting, formatting, and annotations</li>
        <li>Two-way conversion between inline &lt;wo:*&gt; tags and classic WOD declarations</li>
        <li>Component API (.api) GUI and XML editor</li>
        <li>New WebObjects project wizard and run configurations</li>
        <li>Cross-navigation between Java, HTML templates, and WOD files</li>
      </ul>
    ]]></description>

    <idea-version since-build="262" />

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>
    <depends>com.intellij.modules.xml</depends>
    <depends>org.jetbrains.idea.maven</depends>

    <actions>
        <action id="org.wocommunity.plugins.intellij.actions.wocomponent.NewWOComponentAction"
                class="org.wocommunity.plugins.intellij.actions.wocomponent.NewWOComponentAction"
                text="WOComponent"
                description="Create a new WOComponent"
                icon="icons/WOComponentIcon.svg">
            <add-to-group group-id="NewGroup" anchor="before" relative-to-action="NewFromTemplate"/>
        </action>
        <action id="org.wocommunity.plugins.intellij.eomodel.NewEOModelAction"
                class="org.wocommunity.plugins.intellij.eomodel.NewEOModelAction"
                text="EOModel"
                description="Create a new WebObjects EOModel"
                icon="icons/EOModelIcon.svg">
            <add-to-group group-id="NewGroup" anchor="after" relative-to-action="org.wocommunity.plugins.intellij.actions.wocomponent.NewWOComponentAction"/>
        </action>
        <action id="org.wocommunity.plugins.intellij.actions.NewWOProjectAction"
                class="org.wocommunity.plugins.intellij.wizards.NewWOProjectAction"
                text="WebObjects Project..."
                description="Create a new WebObjects or Project Wonder Maven project from archetype"
                icon="icons/WebObjectsIcon.svg">
            <add-to-group group-id="NewGroup" anchor="before" relative-to-action="NewFromTemplate"/>
        </action>
        <action id="SwitchToSrcAction"
                class="org.wocommunity.plugins.intellij.components.SwitchToSrcAction"
                text="Open Source File"
                description="Opens the Java/Kotlin source file for the current WO Component">
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta alt 1"/>
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt 1"/>
        </action>
        <action id="SwitchToWOComponentAction"
                class="org.wocommunity.plugins.intellij.components.SwitchToWOComponentAction"
                text="Open WOComponent"
                description="Opens the WO Component for the current Java/Kotlin source file">
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta alt 2"/>
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt 2"/>
        </action>
        <action id="org.wocommunity.plugins.intellij.components.conversion.ConvertToWodAction"
                class="org.wocommunity.plugins.intellij.components.conversion.ConvertToWodAction"
                text="Convert to WOD"
                description="Converts inline wo:* tags in the template to classic WOD declarations">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
        <action id="org.wocommunity.plugins.intellij.eogen.actions.EOGenerateAction"
                class="org.wocommunity.plugins.intellij.eogen.actions.EOGenerateAction"
                text="EOGenerate..."
                description="Run EOGenerator to generate Java source files"
                icon="icons/EOGenIcon.svg">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>
        <action id="org.wocommunity.plugins.intellij.components.conversion.ConvertToInlineAction"
                class="org.wocommunity.plugins.intellij.components.conversion.ConvertToInlineAction"
                text="Convert to Inline"
                description="Converts classic webobject tags to modern inline wo:* template tags">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
    </actions>

    <extensions defaultExtensionNs="com.intellij">
        <moduleBuilder builderClass="org.wocommunity.plugins.intellij.wizards.WOModuleBuilder" id="WebObjects"/>
        <configurationType
                implementation="org.wocommunity.plugins.intellij.runconfig.WORunConfigType"/>
        <runConfigurationProducer implementation="org.wocommunity.plugins.intellij.runconfig.WORunConfigurationProducer"/>
        <treeStructureProvider implementation="org.wocommunity.plugins.intellij.components.WOComponentTreeStructureProvider"/>
        <fileEditorProvider implementation="org.wocommunity.plugins.intellij.components.WOComponentEditorProvider"/>
        <iconProvider implementation="org.wocommunity.plugins.intellij.components.WOComponentIconProvider"/>
        <editorTabTitleProvider implementation="org.wocommunity.plugins.intellij.components.WOComponentEditorTabTitleProvider"/>
        <selectInTarget implementation="org.wocommunity.plugins.intellij.components.WOComponentSelectInTarget"/>

        <!-- EOModel extensions -->
        <treeStructureProvider implementation="org.wocommunity.plugins.intellij.eomodel.EOModelTreeStructureProvider"/>
        <fileEditorProvider implementation="org.wocommunity.plugins.intellij.eomodel.EOModelEditorProvider"/>
        <iconProvider implementation="org.wocommunity.plugins.intellij.eomodel.EOModelIconProvider"/>
        <editorTabTitleProvider implementation="org.wocommunity.plugins.intellij.eomodel.EOModelEditorTabTitleProvider"/>

        <!-- EOGenerator extensions -->
        <fileEditorProvider implementation="org.wocommunity.plugins.intellij.eogen.editor.EOGenEditorProvider"/>

        <xml.elementDescriptorProvider
                implementation="org.wocommunity.plugins.intellij.wotemplate.WOHtmlElementDescriptorProvider"/>
        <xml.xmlExtension
                implementation="org.wocommunity.plugins.intellij.wotemplate.WOHtmlXmlExtension"/>
        <xml.fileNSInfoProvider
                implementation="org.wocommunity.plugins.intellij.wotemplate.WOHtmlFileNSInfoProvider"/>
        <gotoDeclarationHandler
                implementation="org.wocommunity.plugins.intellij.wotemplate.WOHtmlComponentGotoDeclarationHandler"/>

        <completion.contributor language="HTML"
                                implementationClass="org.wocommunity.plugins.intellij.wotemplate.WOHtmlTagCompletionContributor"/>
        <completion.contributor language="XHTML"
                                implementationClass="org.wocommunity.plugins.intellij.wotemplate.WOHtmlTagCompletionContributor"/>

        <completion.contributor language="HTML"
                                implementationClass="org.wocommunity.plugins.intellij.wotemplate.WOHtmlAttributeCompletionContributor"/>
        <completion.contributor language="XHTML"
                                implementationClass="org.wocommunity.plugins.intellij.wotemplate.WOHtmlAttributeCompletionContributor"/>

        <completion.contributor language="HTML"
                                implementationClass="org.wocommunity.plugins.intellij.wotemplate.WOHtmlBindingCompletionContributor"/>
        <completion.contributor language="XHTML"
                                implementationClass="org.wocommunity.plugins.intellij.wotemplate.WOHtmlBindingCompletionContributor"/>

        <psi.referenceContributor language="HTML"
                                  implementation="org.wocommunity.plugins.intellij.wotemplate.WOHtmlBindingReferenceContributor"/>
        <psi.referenceContributor language="XHTML"
                                  implementation="org.wocommunity.plugins.intellij.wotemplate.WOHtmlBindingReferenceContributor"/>

        <psi.referenceContributor language="HTML"
                                  implementation="org.wocommunity.plugins.intellij.wotemplate.WOHtmlWebObjectReferenceContributor"/>
        <psi.referenceContributor language="XHTML"
                                  implementation="org.wocommunity.plugins.intellij.wotemplate.WOHtmlWebObjectReferenceContributor"/>

        <referencesSearch implementation="org.wocommunity.plugins.intellij.java.search.WOKvcReferencesSearcher"/>
        <methodReferencesSearch implementation="org.wocommunity.plugins.intellij.java.search.WOKvcMethodReferencesSearcher"/>

        <annotator language="HTML" implementationClass="org.wocommunity.plugins.intellij.wotemplate.WOHtmlAnnotator"/>
        <annotator language="XHTML" implementationClass="org.wocommunity.plugins.intellij.wotemplate.WOHtmlAnnotator"/>

        <localInspection language="HTML"
                         shortName="WORequiredBindings"
                         displayName="Missing required WebObjects binding"
                         groupName="WebObjects"
                         enabledByDefault="true"
                         level="WARNING"
                         implementationClass="org.wocommunity.plugins.intellij.wotemplate.WORequiredBindingsInspection"/>

        <fileType name="WebObjects API" implementationClass="org.wocommunity.plugins.intellij.psi.api.WOApiFileType" fieldName="INSTANCE" language="XML" extensions="api"/>

        <lang.inspectionSuppressor language="HTML"
                                   implementationClass="org.wocommunity.plugins.intellij.wotemplate.WOHtmlInspectionSuppressor"/>
        <lang.inspectionSuppressor language="XHTML"
                                   implementationClass="org.wocommunity.plugins.intellij.wotemplate.WOHtmlInspectionSuppressor"/>

        <!-- EOGen files -->
        <fileType name="EOGenerator" implementationClass="org.wocommunity.plugins.intellij.eogen.EOGenFileType" fieldName="INSTANCE" language="TEXT" extensions="eogen"/>

        <!-- WOD files -->
        <fileType name="Web Object Declaration" implementationClass="org.wocommunity.plugins.intellij.wod.WODFileType" fieldName="INSTANCE" language="WOD" extensions="wod"/>
        <lang.parserDefinition language="WOD" implementationClass="org.wocommunity.plugins.intellij.wod.WODParserDefinition"/>
        <lang.formatter language="WOD" implementationClass="org.wocommunity.plugins.intellij.wod.WODFormattingModelBuilder"/>
        <lang.syntaxHighlighterFactory language="WOD" implementationClass="org.wocommunity.plugins.intellij.wod.WODSyntaxHighlighterFactory"/>
        <annotator language="WOD" implementationClass="org.wocommunity.plugins.intellij.wod.WODAnnotator"/>
        <completion.contributor language="WOD" implementationClass="org.wocommunity.plugins.intellij.wod.WODCompletionContributor"/>

        <!-- WOD Editor enhancements -->
        <lang.commenter language="WOD"
                        implementationClass="org.wocommunity.plugins.intellij.wod.WodCommenter"/>
        <lang.braceMatcher language="WOD"
                           implementationClass="org.wocommunity.plugins.intellij.wod.WodPairedBraceMatcher"/>
        <lang.quoteHandler language="WOD"
                           implementationClass="org.wocommunity.plugins.intellij.wod.WodQuoteHandler"/>
        <enterHandlerDelegate implementationClass="org.wocommunity.plugins.intellij.wod.WodEnterHandlerDelegate"/>
        <codeInsight.lineMarkerProvider language="HTML"
                                        implementationClass="org.wocommunity.plugins.intellij.wod.WOHtmlToWodLineMarkerProvider"/>
        <codeInsight.lineMarkerProvider language="XHTML"
                                        implementationClass="org.wocommunity.plugins.intellij.wod.WOHtmlToWodLineMarkerProvider"/>
        <codeInsight.lineMarkerProvider language="WOD"
                                        implementationClass="org.wocommunity.plugins.intellij.wod.WodToHtmlLineMarkerProvider"/>
        <codeInsight.lineMarkerProvider language="JAVA"
                                        implementationClass="org.wocommunity.plugins.intellij.java.linemarker.JavaLineMarkerProvider"/>
        <intentionAction>
            <className>org.wocommunity.plugins.intellij.wod.CreateWodElementIntentionAction</className>
            <category>WebObjects</category>
        </intentionAction>
        <localInspection language="WOD"
                         shortName="WodRequiredBindings"
                         displayName="Missing required WOD binding"
                         groupName="WebObjects"
                         enabledByDefault="true"
                         level="WARNING"
                         implementationClass="org.wocommunity.plugins.intellij.wod.WodRequiredBindingsInspection"/>
    </extensions>

    <projectListeners>
        <listener class="org.wocommunity.plugins.intellij.components.WOComponentAutoSelectListener"
                  topic="com.intellij.openapi.fileEditor.FileEditorManagerListener"/>
    </projectListeners>
</idea-plugin>
